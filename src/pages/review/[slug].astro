---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommunityWidget from '../../components/CommunityWidget.astro';
import { generateArticleSchema, generateBreadcrumbSchema } from '../../lib/schema';
import { siteConfig } from '../../data/site';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(rev => ({
    params: { slug: rev.slug },
    props: { review: rev }
  }));
}

export interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { Content } = await review.render();
const data = review.data;

const breadcrumbs = [
  { name: '白皮书评测', item: '/review/' },
  { name: data.title, item: Astro.url.pathname }
];

const articleSchema = generateArticleSchema({
  title: data.title,
  description: data.description,
  url: Astro.url.href,
  publishedAt: data.publishedAt,
  updatedAt: data.updatedAt,
  authorName: '网络运维架构师'
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: '首页', item: '/' },
  ...breadcrumbs
]);

const seoProps = {
  title: data.title,
  description: data.description,
  canonical: Astro.url.href,
  keywords: data.keywords || []
};
---
<BaseLayout seo={seoProps} schema={[articleSchema, breadcrumbSchema]}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-10 pb-6 border-b border-zinc-200/80">
      <div class="inline-block px-3 py-1 bg-zinc-100 border border-zinc-200 text-zinc-700 text-xs font-semibold rounded-full mb-3">
        白皮书实测指南
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight leading-tight mb-4">
        {data.title}
      </h1>
      <p class="text-lg text-zinc-600 leading-relaxed mb-4">
        {data.description}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs text-zinc-400 pt-2">
        <div>📅 压测时间: {data.updatedAt}</div>
        <div>✍️ 审核: {siteConfig.author.name}</div>
        <div>⚡ 测试环境: 千兆独享 BGP 压测</div>
      </div>
    </header>

    <article class="prose prose-zinc max-w-none prose-headings:font-bold prose-headings:text-zinc-900 prose-a:text-sky-600 prose-a:no-underline hover:prose-a:underline">
      <Content />
    </article>

    <CommunityWidget />
  </div>
</BaseLayout>
