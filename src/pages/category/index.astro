---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories } from '../../data/categories';
import { siteConfig } from '../../data/site';

const breadcrumbs = [
  { name: '全站分类', item: '/category/' }
];

const seoProps = {
  title: '2026 网络连接服务分类导引',
  description: '浏览机场推荐、稳定专线、性价比选型、IPLC、节点测速、流媒体与游戏加速等核心分类。',
  canonical: `${siteConfig.url}/category/`
};
---
<BaseLayout seo={seoProps}>
  <div class="container page-padding">
    <Breadcrumbs items={breadcrumbs} />

    <header class="archive-header card">
      <h1>🗂️ 全站内容分类导航</h1>
      <p>选择你感兴趣的技术维度或需求分类，获取专业的选型指导。</p>
    </header>

    <div class="grid-3">
      {categories.map(cat => (
        <div class="category-card card">
          <h2><a href={`/category/${cat.slug}/`}>{cat.name}</a></h2>
          <p>{cat.summary}</p>
          <a href={`/category/${cat.slug}/`} class="link-arrow">浏览 {cat.name} 文章 →</a>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.page-padding {
  padding-top: 2rem;
  padding-bottom: 4rem;
}

.archive-header { margin-bottom: 2rem; }
.archive-header h1 { margin-top: 0; }

.category-card h2 {
  margin-top: 0;
  margin-bottom: 0.6rem;
  font-size: 1.25rem;
}

.category-card h2 a { color: var(--color-text-main); }
.category-card h2 a:hover { color: var(--color-primary); }

.category-card p {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  margin-bottom: 1.2rem;
}

.link-arrow {
  font-size: 0.85rem;
  font-weight: 600;
}
</style>
