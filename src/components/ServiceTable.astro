---
import type { ServiceEntity } from '../data/services';

export interface Props {
  services: ServiceEntity[];
}

const { services } = Astro.props;
---
<div class="my-8 bg-white border border-slate-200/80 rounded-2xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 text-slate-700 font-bold text-xs tracking-wider uppercase border-b border-slate-200">
          <th class="py-3.5 px-5">服务品牌</th>
          <th class="py-3.5 px-5">线路架构</th>
          <th class="py-3.5 px-5">节点覆盖</th>
          <th class="py-3.5 px-5">入门价格</th>
          <th class="py-3.5 px-5">晚高峰压测采样</th>
          <th class="py-3.5 px-5">更新时间</th>
          <th class="py-3.5 px-5 text-right">官方通道</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        {services.map(srv => {
          const lowestPlan = srv.plans && srv.plans[0];
          const samplePerf = srv.performance && srv.performance[0];
          return (
            <tr class="hover:bg-slate-50/80 transition-colors duration-150">
              <td class="py-3.5 px-5 font-bold text-slate-900">
                {srv.hasDetails ? (
                  <a href={`/service/${srv.slug}/`} class="text-slate-900 hover:text-blue-600 transition-colors font-semibold">
                    {srv.name}
                  </a>
                ) : (
                  <span>{srv.name}</span>
                )}
              </td>
              <td class="py-3.5 px-5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200/60">
                  {srv.routes.length > 0 ? srv.routes.join(', ') : '暂无公开资料'}
                </span>
              </td>
              <td class="py-3.5 px-5 text-slate-600 text-xs">
                {srv.regions.length > 0 ? srv.regions.slice(0, 3).join(', ') : '暂无公开资料'}
              </td>
              <td class="py-3.5 px-5">
                <span class="text-blue-600 font-bold text-sm">
                  {lowestPlan ? `${lowestPlan.price}/${lowestPlan.duration}` : '以服务商实际信息为准'}
                </span>
              </td>
              <td class="py-3.5 px-5">
                {samplePerf && samplePerf.latency ? (
                  <span class="inline-flex items-center gap-1 text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200/60">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {samplePerf.region} {samplePerf.latency}
                  </span>
                ) : (
                  <span class="text-xs text-slate-400">待补充采样</span>
                )}
              </td>
              <td class="py-3.5 px-5 text-xs text-slate-400">{srv.updatedAt}</td>
              <td class="py-3.5 px-5 text-right">
                {srv.affiliateUrl ? (
                  <a href={srv.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-bold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-xs">
                    官网直达 →
                  </a>
                ) : srv.hasDetails ? (
                  <a href={`/service/${srv.slug}/`} class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-100 text-slate-700 border border-slate-200/80 hover:bg-slate-200 transition-colors">
                    查看资料
                  </a>
                ) : (
                  <span class="text-xs text-slate-400">-</span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
