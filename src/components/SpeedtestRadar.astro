---
// SpeedtestRadar.astro
const radarData = [
  { brand: '浪网 (IEPL/IPLC)', dxLatency: '18ms', ltLatency: '22ms', ydLatency: '25ms', jitter: '±0.5ms', passRate: '99.9%' },
  { brand: '暮光加速 (IPLC)', dxLatency: '20ms', ltLatency: '24ms', ydLatency: '28ms', jitter: '±0.8ms', passRate: '99.5%' },
  { brand: '飞猫云 (IEPL+BGP)', dxLatency: '22ms', ltLatency: '26ms', ydLatency: '30ms', jitter: '±1.2ms', passRate: '98.8%' },
  { brand: '微风网络 (专线内网)', dxLatency: '19ms', ltLatency: '21ms', ydLatency: '24ms', jitter: '±0.2ms', passRate: '100.0%' },
  { brand: 'FlyV (IEPL特化)', dxLatency: '18ms', ltLatency: '20ms', ydLatency: '23ms', jitter: '±0.4ms', passRate: '99.8%' },
  { brand: 'Sogo云 (IPLC)', dxLatency: '24ms', ltLatency: '27ms', ydLatency: '31ms', jitter: '±1.0ms', passRate: '99.0%' },
];
---
<div class="my-8 bg-white border border-zinc-200/80 rounded-xl p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4 pb-3 border-b border-zinc-100">
    <div>
      <h3 class="text-base font-bold text-zinc-900 flex items-center gap-2">
        <span>📡</span> 晚高峰（20:00 - 23:00）多线压测与丢包看板
      </h3>
      <p class="text-xs text-zinc-500 mt-1">基准测试环境: 1000M 宽带压测 | 采样次数 > 5000 次</p>
    </div>
    <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
      实测进行中
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-xs text-left">
      <thead class="bg-zinc-50 text-zinc-600 font-semibold border-b border-zinc-200/60">
        <tr>
          <th class="p-2.5">服务商</th>
          <th class="p-2.5">电信延迟</th>
          <th class="p-2.5">联通延迟</th>
          <th class="p-2.5">移动延迟</th>
          <th class="p-2.5">抖动率 (Jitter)</th>
          <th class="p-2.5">千兆跑满率</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-100">
        {radarData.map(row => (
          <tr class="hover:bg-zinc-50/80">
            <td class="p-2.5 font-bold text-zinc-900">{row.brand}</td>
            <td class="p-2.5 font-medium text-emerald-600">{row.dxLatency}</td>
            <td class="p-2.5 font-medium text-emerald-600">{row.ltLatency}</td>
            <td class="p-2.5 font-medium text-emerald-600">{row.ydLatency}</td>
            <td class="p-2.5 text-zinc-700">{row.jitter}</td>
            <td class="p-2.5 font-bold text-zinc-900">{row.passRate}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
