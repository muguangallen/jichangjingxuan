---
export interface Column {
  key: string;
  label: string;
}

export interface Props {
  columns: Column[];
  data: Record<string, any>[];
  title?: string;
}

const { columns, data, title } = Astro.props;
---
<div class="my-8 bg-white border border-slate-200/80 rounded-2xl shadow-sm overflow-hidden">
  {title && (
    <div class="px-5 py-4 bg-slate-50/80 border-b border-slate-200/80">
      <h3 class="text-base font-bold text-slate-900">{title}</h3>
    </div>
  )}
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left border-collapse">
      <thead>
        <tr class="bg-slate-50 text-slate-700 font-bold text-xs tracking-wider uppercase border-b border-slate-200">
          {columns.map(col => (
            <th class="py-3.5 px-5">{col.label}</th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 bg-white">
        {data.map(row => (
          <tr class="hover:bg-slate-50/80 transition-colors duration-150">
            {columns.map((col, idx) => (
              <td class={`py-3.5 px-5 ${idx === 0 ? 'font-semibold text-slate-900' : 'text-slate-700'}`}>
                {row[col.key]}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
